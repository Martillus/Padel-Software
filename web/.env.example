# Copia este archivo como .env.local (en esta carpeta web/) y rellena lo que necesites.
# Nunca subas .env.local a git.

# --- Chat con Claude ------------------------------------------------------------
# Sin clave, el chat funciona en "modo demostración".
ANTHROPIC_API_KEY=
# Modelo y esfuerzo del chat (opcional). Cambiar a claude-haiku-5-5 abarata mucho cada pregunta.
ANTHROPIC_MODEL=claude-opus-5-5
CHAT_EFFORT=low

# --- Motor de análisis (modo local) ----------------------------------------------
# Comando del motor. Si no está en el PATH, pon la ruta completa, por ejemplo en Windows:
# PADEL_ENGINE_CMD=C:\Users\TU_USUARIO\Downloads\Padel-Software\engine\.venv\Scripts\padel-engine.exe
PADEL_ENGINE_CMD=padel-engine
# Carpeta donde se guardan vídeos y resultados (por defecto web/.data)
# PADEL_DATA_DIR=

# --- Acceso privado (cuando la web está publicada) --------------------------------------
# Con contraseña: la web pide esta contraseña antes de mostrar nada.
# SITE_PASSWORD=
# Para hacerla pública más adelante:
# SITE_PUBLIC=true
