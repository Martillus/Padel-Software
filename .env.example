# Copia este fichero como .env (no lo subas nunca a git) y rellena los valores.

# --- Fase 1: motor de análisis -------------------------------------------
# Clave de la API de Anthropic (Claude) para redactar los informes.
# Sin ella, el motor genera un informe de plantilla sin IA.
ANTHROPIC_API_KEY=
# Modelo y nivel de esfuerzo (opcional). Ver docs/DECISIONES.md, sección costes.
PADEL_LLM_MODEL=claude-opus-5-5
PADEL_LLM_EFFORT=medium

# --- Fase 2 (todavía no se usan) -----------------------------------------
# Supabase (región UE, p. ej. Frankfurt eu-central-1)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# Cloudflare R2 (jurisdicción UE)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# Worker GPU (Modal)
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=

# --- Fase 3 ------------------------------------------------------------------
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
